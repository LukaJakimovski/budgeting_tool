# Tally sync server settings (see docs/self-hosting.md for all options).
TALLY_HOST=127.0.0.1
TALLY_PORT=8787
TALLY_DATA_DIR=/var/lib/tally
# Point this at a Syncthing/Nextcloud folder to copy backups off the Pi automatically.
# The service is sandboxed, so also allow writing there:
#   sudo systemctl edit tally-server   →   [Service]
#                                          ProtectHome=false
#                                          ReadWritePaths=/home/pi/Sync/tally-backups
# TALLY_BACKUP_DIR=/home/pi/Sync/tally-backups
# Require a secret to create new vaults (recommended if friends use your server):
# TALLY_SIGNUP_SECRET=change-me
# Stop new vaults from being created at all:
# TALLY_ALLOW_SIGNUP=false
