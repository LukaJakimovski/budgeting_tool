{
  "name": "tally-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Tally for Linux (Tauri wrapper around the web app in ../app)",
  "scripts": {
    "build:web": "npm --prefix ../app run build",
    "dev": "tauri dev",
    "build": "npm run build:web && tauri build",
    "build:nobundle": "npm run build:web && tauri build --no-bundle"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
